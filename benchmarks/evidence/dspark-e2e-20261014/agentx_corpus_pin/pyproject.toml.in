# Campaign-only plugin template; materialize outside the AISimulate checkout.
[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "aisim-dspark-agentx-corpus-pin"
version = "0.1.0"
requires-python = ">=3.11"
description = "Immutable corpus identity for the DSpark AgentX campaign"

[project.entry-points."aiperf.plugins"]
aisim-dspark-corpus-pin = "aisim_agentx_pin:plugins.yaml"

[tool.setuptools.package-data]
aisim_agentx_pin = ["plugins.yaml"]
